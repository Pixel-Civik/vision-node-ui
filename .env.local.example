# Copiar a .env.local y completar con las credenciales del proyecto.
# .env.local no se versiona (ver .gitignore).
#
# IMPORTANTE: el prefijo NEXT_PUBLIC_ expone la variable al navegador.
# Usar exclusivamente la clave anon. La clave service_role omite las politicas
# RLS y publicarla equivaldria a conceder acceso total a la base de datos.

NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clave anon del proyecto>

# Sólo servidor: videos privados GCS mediante OIDC efímero, sin llave JSON.
GCP_PROJECT_ID=lens-506116
GCP_PROJECT_NUMBER=1039739275295
GCP_STORAGE_BUCKET=lens-506116-shoplifting-evidence
GCP_SERVICE_ACCOUNT_EMAIL=shoplifting-vercel@lens-506116.iam.gserviceaccount.com
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel-shoplifting
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel-production
